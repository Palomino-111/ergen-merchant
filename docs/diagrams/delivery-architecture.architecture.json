    {
      "dot": "cyan",
      "title": "生命周期顺序",
      "items": [
        "① 消费者下单 → create-order 落库，初始 awaiting_preparation",
        "② 商家备餐完成 → dispatch-delivery-order 触发发单",
        "③ Edge Function 读商家取货地址与收货地址",
        "④ method=order 下发真实运力，写回 provider_order_id",
        "⑤ 快递100 回调 → 验签 → 更新状态与骑手 → 消费者可见"
      ]
    },
    {
      "dot": "violet",
      "title": "快递100 同城急送：8 个接口",
      "items": [
        "出站 method=price 查价（免费）｜method=batchPrice 批量查价（免费）",
        "出站 method=order 下单｜method=batchOrder 并呼抢单",
        "出站 method=cancel 取消（可能产生取消费）｜method=addfee 加小费",
        "出站 method=queryCourier 骑手位置（仅经纬度，没有状态）",
        "入站 回调 callbackUrl：POST 表单 taskId + param + sign = MD5(param + salt)"
      ]
    },
    {
      "dot": "amber",
      "title": "落地约束",
      "items": [
        "回调函数必须 verify_jwt: false（快递100 不带 Supabase JWT）",
        "callbackUrl ≤ 50 字符，Supabase 原生地址 71 字符放不下",
        "回调最多推 3 次、间隔 1 分钟：全丢就没有第二次机会",
        "状态只能单调前进，防伪造「已取消」与迟到的「配送中」"
      ]
    }
  ]
